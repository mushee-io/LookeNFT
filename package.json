{
  "name": "lookenft",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test tests/*.integration.test.ts",
    "check": "npm run typecheck && npm run test && npm run test:integration && npm run build",
    "indexer:once": "tsx scripts/indexer-once.ts",
    "indexer:register": "tsx scripts/register-collection.ts",
    "indexer:verify": "tsx scripts/verify-independent.ts",
    "indexer:reindex": "tsx scripts/reindex-testnet.ts",
    "contracts:compile": "hardhat compile",
    "contracts:test": "hardhat test",
    "contracts:clean": "hardhat clean",
    "contracts:analyze": "node scripts/m4-contract-artifacts.cjs",
    "test:m4": "hardhat test contract-tests/LookeCollectionFactory.test.js contract-tests/LookeCollectionFactory.fuzz.test.js"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "pg": "8.16.3",
    "viem": "2.38.5",
    "jose": "6.1.0",
    "@walletconnect/ethereum-provider": "2.26.0",
    "qrcode.react": "4.2.0",
    "@openzeppelin/contracts": "5.5.0"
  },
  "devDependencies": {
    "@types/node": "22.18.10",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/pg": "8.15.5",
    "typescript": "5.9.3",
    "tsx": "4.20.6",
    "hardhat": "2.29.1",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "ethers": "6.15.0",
    "solc": "0.8.30",
    "fast-check": "4.3.0"
  }
}
