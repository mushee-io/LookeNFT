    "qrcode.react": "4.2.0"
  },
  "devDependencies": {
    "@types/node": "22.18.10",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/pg": "8.15.5",
    "typescript": "5.9.3",
