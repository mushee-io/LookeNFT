# M2 development. Never commit filled credentials or private keys.
NEXT_PUBLIC_ULTRA_NETWORK=testnet
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://lookenft:change_me@localhost:5432/lookenft

# Public WalletConnect/Reown project ID required for QR pairing, optional for injected wallets.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Set ONLY when Looke Social can issue real signed identity assertions.
# Public verification key for EdDSA JWTs (use literal \n in the .env value).
LOOKE_IDENTITY_PUBLIC_KEY_PEM=
LOOKE_IDENTITY_ISSUER=

# M3 canonical read-only Ultra EVM Testnet NFT indexer
NFT_START_BLOCK=
NFT_CONFIRMATIONS=12
NFT_MAX_BLOCKS=25
NFT_COLLECTION_ADDRESS=
NFT_COLLECTION_STANDARD=
NFT_DEPLOYMENT_BLOCK=
NFT_INDEPENDENT_RPC_URL=
NFT_METADATA_ALLOWED_HOSTS=
NFT_IPFS_GATEWAY=

# M4 factory releases are DISABLED unless a human operator explicitly authorises a
# wallet-signed real Ultra EVM Testnet factory deployment and provides its address.
NEXT_PUBLIC_M4_ENABLE_DEPLOYMENT=false
NEXT_PUBLIC_M4_FACTORY_ADDRESS=

# Operator-only read-only manifest verification of a genuinely wallet-signed
# collection deployment; never set secrets, seed phrases or private keys.
M4_FACTORY_ADDRESS=
M4_CREATION_TX_HASH=
M4_INDEPENDENT_RPC_URL=

# M4 Cancun MCOPY/PUSH0 compatibility was NOT independently proved on Ultra EVM Testnet.
# Set true only after real operator signed independent compatibility evidence.
NEXT_PUBLIC_M4_CANCUN_VERIFIED=false
