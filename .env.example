# M2 development. Never commit filled credentials or private keys.
NEXT_PUBLIC_ULTRA_NETWORK=testnet
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://lookenft:change_me@localhost:5432/lookenft

# Public WalletConnect/Reown project ID required for QR pairing, optional for injected wallets.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Set ONLY when Looke Social can issue real signed identity assertions.
# Public verification key for EdDSA JWTs (use literal \n in the .env value).
LOOKE_IDENTITY_PUBLIC_KEY_PEM=
LOOKE_IDENTITY_ISSUER=

# M3 canonical read-only Ultra EVM Testnet NFT indexer
NFT_START_BLOCK=
NFT_CONFIRMATIONS=12
NFT_MAX_BLOCKS=25
NFT_COLLECTION_ADDRESS=
NFT_COLLECTION_STANDARD=
NFT_DEPLOYMENT_BLOCK=
NFT_INDEPENDENT_RPC_URL=
NFT_METADATA_ALLOWED_HOSTS=
NFT_IPFS_GATEWAY=

# M4 factory releases are DISABLED unless a human operator explicitly authorises a
# wallet-signed real Ultra EVM Testnet factory deployment and provides its address.
NEXT_PUBLIC_M4_ENABLE_DEPLOYMENT=false
NEXT_PUBLIC_M4_FACTORY_ADDRESS=

# Operator-only read-only manifest verification of a genuinely wallet-signed
# collection deployment; never set secrets, seed phrases or private keys.
M4_FACTORY_ADDRESS=
M4_CREATION_TX_HASH=
M4_INDEPENDENT_RPC_URL=

# M4 Cancun MCOPY/PUSH0 compatibility was NOT independently proved on Ultra EVM Testnet.
# Set true only after real operator signed independent compatibility evidence.
NEXT_PUBLIC_M4_CANCUN_VERIFIED=false

# M5 real wallet-confirmed native-UOS minting. OFF until independent acceptance.
NEXT_PUBLIC_M5_ENABLE_MINTING=false

# Read-only independent mint receipt verifier after user approved a real tx.
M5_FACTORY_ADDRESS=
M5_COLLECTION_ADDRESS=
M5_CREATION_MINT_TX_HASH=
M5_INDEPENDENT_RPC_URL=

# M6 — Secure creator media. Always OFF without actual operator integrations.
# Never put service credentials in NEXT_PUBLIC_* keys or GitHub PRs.
M6_MEDIA_UPLOADS_ENABLED=false
M6_CLOUDINARY_CLOUD_NAME=
M6_CLOUDINARY_API_KEY=
M6_CLOUDINARY_API_SECRET=
# A trusted operator-managed ClamAV INSTREAM scanner (private VPC network).
M6_CLAMAV_HOST=
M6_CLAMAV_PORT=3310
# Human reviewers must be real wallet-authenticated operator-approved accounts.
M6_MODERATOR_WALLETS=

# Approved media can be pinned only after human moderation and a second
# file checksum + malware scan. Pinning is disabled without real JWT and gateway.
M6_IPFS_PINNING_ENABLED=false
M6_PINATA_JWT=
M6_IPFS_GATEWAY=
# Also configure NFT_METADATA_ALLOWED_HOSTS to include the approved gateway hostname.

# M7 — Fixed-price NFT marketplace, Ultra EVM Testnet ONLY
# IMPORTANT: All OFF without independent contract/operator verification.
NEXT_PUBLIC_M7_ENABLE_LISTINGS=false
M7_LISTINGS_ENABLED=false
NEXT_PUBLIC_M7_ENABLE_SETTLEMENT=false
NEXT_PUBLIC_M7_ENABLE_CANCELLATION=false
NEXT_PUBLIC_M7_MARKET_ADDRESS=

# Read-only operator verifier AFTER a real wallet-approved Testnet sale.
# Independent HTTPS RPC must differ from Ultra's primary provider.
M7_MARKET_ADDRESS=
M7_SALE_TX_HASH=
M7_INDEPENDENT_RPC_URL=

# M8 — Fully funded EIP712 buyer offers, Ultra EVM Testnet 18881 only.
# All flags OFF; do not supply a deployed address without independent audit,
# real Cancun compatibility and authorised operator + wallet acceptance.
NEXT_PUBLIC_M8_ENABLE_OFFERS=false
NEXT_PUBLIC_M8_ENABLE_FUNDING=false
NEXT_PUBLIC_M8_ENABLE_ACCEPTANCE=false
NEXT_PUBLIC_M8_ENABLE_REFUNDS=false
NEXT_PUBLIC_M8_OFFER_VAULT_ADDRESS=
M8_OFFER_RECORDING_ENABLED=false
# Read-only external proof ONLY after an actual separately wallet-approved tx.
M8_VAULT_ADDRESS=
M8_EVENT_TX_HASH=
M8_EVENT_KIND=
M8_INDEPENDENT_RPC_URL=

# M9 — Independent read-only marketplace event scanner + orderbook.
# All network ingestion OFF until actual M7/M8 Testnet deployment approval.
M9_READONLY_SYNC_ENABLED=false
M9_ORDER_SNAPSHOT_ENABLED=false
M9_LISTING_MARKET_ADDRESS=
M9_OFFER_VAULT_ADDRESS=
M9_EXPECTED_MARKET_CODE_HASH=
M9_EXPECTED_VAULT_CODE_HASH=
M9_MARKET_START_BLOCK=
M9_INDEPENDENT_RPC_URL=
M9_CONFIRMATIONS=12
M9_MAX_BLOCKS=10
M9_MAX_REORG_DEPTH=50

# M10 — Trusted Looke Social / NFT integration; ALL OFF until source signers exist.
# The checked mushee-io/looke main repository DOES NOT have an M10 EdDSA issuer.
M10_SOCIAL_SYNC_ENABLED=false
M10_OWNERSHIP_VERIFY_ENABLED=false
M10_PUBLIC_DISCOVERY_ENABLED=false
M10_SOCIAL_BLOCK_POLICY_ATTESTED=false
NEXT_PUBLIC_M10_SOCIAL_UI_ENABLED=false
NEXT_PUBLIC_M10_AVATAR_UI_ENABLED=false
NEXT_PUBLIC_M10_CREATOR_DIRECTORY_ENABLED=false
NEXT_PUBLIC_M10_LOOKE_SOCIAL_ORIGIN=
# Operator-pinned public verification only. NEVER any private signing key here.
M10_SOCIAL_PUBLIC_KEY_PEM=
M10_SOCIAL_ISSUER=
M10_SOCIAL_SOURCE_COMMIT=
# Media may display only after trusted public post moderation and hostname pinning.
M10_SOCIAL_MEDIA_ALLOWED_HOSTS=
M10_APPROVED_IPFS_GATEWAY=
# Real independent HTTPS Ultra EVM Testnet RPC, different provider/hostname.
M10_INDEPENDENT_RPC_URL=

# M11 — REAL source security acceptance (all OFF; M12 is FINAL milestone).
# Any submitted evidence remains unverified; no code can approve its own audit.
M11_REVOCATION_SYNC_ENABLED=false
M11_VISIBILITY_CHECK_ENABLED=false
M11_ACCEPTANCE_READ_ENABLED=false
M11_EVIDENCE_SUBMISSIONS_ENABLED=false
M11_MEDIA_RECONCILE_ENABLED=false
M11_NFT_WITNESS_RECHECK_ENABLED=false
M11_OPERATOR_READONLY_CHECK_ENABLED=false
M11_LOCAL_RESTORE_REHEARSAL=false
M11_OPERATOR_WALLETS=
# Signatures are verified only from an external human-reviewed issuer.
M11_EVIDENCE_ISSUER=
M11_EVIDENCE_PUBLIC_KEY_PEM=
# Dedicated independent read-only IPFS gateway preapproved by operator.
M11_PINNED_METADATA_GATEWAY=
# Never configure an actual source JWT or source private signing key in Git.
M11_SIGNED_REVOCATION_JWT=

# M12 FINAL Ultra EVM Testnet acceptance — every action OFF.
# This is a NO_GO assessment, not a production authorisation mechanism.
M12_OPERATOR_RECORD_NO_GO=false
M12_SIGNED_HUMAN_CANDIDATES_ENABLED=false
M12_SOURCE_CHECK_ENABLED=false
M12_FINAL_PUBLIC_BETA_ENABLED=false
M12_FINAL_MAINNET_ENABLED=false
M12_FINAL_FINANCIAL_EXECUTION_ENABLED=false
# Genuine operator-approved independent RPC and deployed Testnet code hashes only.
M12_INDEPENDENT_RPC_URL=
M12_APPROVED_FACTORY_ADDRESS=
M12_APPROVED_FACTORY_CODE_HASH=
M12_APPROVED_MARKET_ADDRESS=
M12_APPROVED_MARKET_CODE_HASH=
M12_APPROVED_OFFER_VAULT_ADDRESS=
M12_APPROVED_OFFER_CODE_HASH=
# Separate externally verified EdDSA public keys and reviewer identities.
M12_SECURITY_REVIEWER_ISSUER=
M12_SECURITY_REVIEWER_PUBLIC_KEY_PEM=
M12_SECURITY_REVIEWER_KEY_ID=
M12_SECURITY_REVIEWER_WALLET=
M12_RELEASE_OPERATOR_ISSUER=
M12_RELEASE_OPERATOR_PUBLIC_KEY_PEM=
M12_RELEASE_OPERATOR_KEY_ID=
M12_RELEASE_OPERATOR_WALLET=
# No reviewer private keys, live wallet secrets, signed tokens or platform cookies in Git.

# LookeNFT curated operator-only NFT drops (no actual wallets or secrets in Git).
# One authenticated wallet may publish verified on-chain collections.
LOOKE_NFT_OPERATOR_WALLET=
# Owner-restricted factory V3 (do not use legacy permissionless V2).
# Must be independently deployed and verified on Ultra EVM Testnet, with
# factory.owner() and each collection.owner() matching LOOKE_NFT_OPERATOR_WALLET.
LOOKE_NFT_OWNER_FACTORY_ADDRESS=
# Comma-separated allowed image hosts (e.g., a verified CDN hostname).
LOOKE_NFT_COVER_HOSTS=
# Run db/migrations/011_curated_mint_catalog.sql after earlier migrations.
# All M12 public-mint and financial execution gates remain OFF until approved.
