# M2 development. Never commit filled credentials or private keys.
NEXT_PUBLIC_ULTRA_NETWORK=testnet
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://lookenft:change_me@localhost:5432/lookenft

# Public WalletConnect/Reown project ID required for QR pairing, optional for injected wallets.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Set ONLY when Looke Social can issue real signed identity assertions.
# Public verification key for EdDSA JWTs (use literal \n in the .env value).
LOOKE_IDENTITY_PUBLIC_KEY_PEM=
LOOKE_IDENTITY_ISSUER=

# M3 canonical read-only Ultra EVM Testnet NFT indexer
NFT_START_BLOCK=
NFT_CONFIRMATIONS=12
NFT_MAX_BLOCKS=25
NFT_COLLECTION_ADDRESS=
NFT_COLLECTION_STANDARD=
NFT_DEPLOYMENT_BLOCK=
NFT_INDEPENDENT_RPC_URL=
NFT_METADATA_ALLOWED_HOSTS=
NFT_IPFS_GATEWAY=
